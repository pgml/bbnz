# —————————————————————————————————————————————————————————————————————————————
# Global commands available across all components
# —————————————————————————————————————————————————————————————————————————————
mode normal {
    bind ":"          fn: cmd
    bind "enter"      fn: confirmAction
    bind "esc"        fn: cancelAction
    bind "gg"         fn: goToTop
    bind "G"          fn: goToBottom
    bind "C-w l"      fn: focusNextColumn
    bind "C-w C-l"    fn: focusNextColumn
    bind "C-w h"      fn: focusPrevColumn
    bind "C-w C-h"    fn: focusPrevColumn
    bind "space e"    fn: showBufferList
    bind "space q"    fn: closeNote              #todo
    bind "space u"    fn: reopenLastClosedNote   #todo
    bind "space n"    fn: newScratch             #todo
}

mode command {
    bind "enter"    fn: confirmAction
    bind "esc"      fn: cancelAction
    bind "up"       fn: historyBack    #todo
    bind "down"     fn: historyForward #todo
}

mode insert {
    bind "esc"    fn: cancelAction
}

mode search {
    bind "enter"    fn: confirmAction         #todo
    bind "esc"      fn: cancelAction          #todo
    bind "C-c"      fn: cancelAction          #todo
    bind "up"       fn: searchHistoryBack     #todo
    bind "down"     fn: searchHistoryForward  #todo
}

# —————————————————————————————————————————————————————————————————————————————
# Commands available for folders and notes
# —————————————————————————————————————————————————————————————————————————————
mode normal(Folders, Notes) {
    bind "j"     fn: lineDown
    bind "k"     fn: lineUp
    bind "R"     fn: renameListItem       #todo
    bind "D"     fn: delListItem          #todo
    bind "P"     fn: togglePinListItem    #todo
    bind "yy"    fn: yankListItem         #todo
    bind "dd"    fn: cutListItem          #todo
    bind "p"     fn: pasteListItem        #todo
    bind "r"     fn: refreshList          #todo
}

mode insert(Folders, Notes) {
    bind "enter"    fn: confirmAction  #todo
    bind "esc"      fn: cancelAction   #todo
}

# —————————————————————————————————————————————————————————————————————————————
# Buffer list commands
# —————————————————————————————————————————————————————————————————————————————
mode normal(BufferList) {
    bind "esc"    fn: closeBufferList #todo
    bind "D"      fn: closeNote       #todo
}

# —————————————————————————————————————————————————————————————————————————————
# Folder commands
# —————————————————————————————————————————————————————————————————————————————
mode normal(Folders) {
    bind "l"    fn: dirtree.treeExpand
    bind "h"    fn: dirtree.treeCollapse
    bind "d"    fn: dirtree.createFolder  #todo
}

# —————————————————————————————————————————————————————————————————————————————
# Command mode keybinds
# —————————————————————————————————————————————————————————————————————————————
mode command {
    bind "backspace"    fn: statusbar.deleteBefore
}

# —————————————————————————————————————————————————————————————————————————————
# Notes commands
# —————————————————————————————————————————————————————————————————————————————
mode normal(Notes) {
    bind "%"    fn: notes.create   #todo
}

# —————————————————————————————————————————————————————————————————————————————
# Editor commands
# —————————————————————————————————————————————————————————————————————————————
# Shared editor commands in all modes

mode normal(Editor), visual(Editor), visual_line(Editor), visual_block(Editor) {
    bind "0"     fn: editor.lineStart
    bind "^"     fn: editor.lineStart    flags: [non_white]
    bind "_"     fn: editor.lineStart    flags: [non_white]
    bind "$"     fn: editor.lineEnd

    bind "F"     fn: editor.findChar           flags: [op, await, prev]  #todo
    bind "G"     fn: editor.goToBottom
    bind "J"     fn: editor.mergeLines
    bind "V"     fn: editor.toggleVisualMode   flags: [line]
    bind "Y"     fn: editor.yank               flags: [end]   #todo

    bind "b"     fn: editor.prevWord
    bind "e"     fn: editor.nextWord     flags: [end]
    bind "f"     fn: editor.findChar     flags: [op, await]        #todo
    bind "h"     fn: editor.charLeft
    bind "j"     fn: editor.lineDown
    bind "k"     fn: editor.lineUp
    bind "l"     fn: editor.charRight
    bind "v"     fn: editor.toggleVisualMode
    bind "w"     fn: editor.nextWord
    bind "s"     fn: editor.substituteText                         #todo
    bind "x"     fn: editor.delChar
    bind "p"     fn: editor.paste                                  #todo
    bind "yy"    fn: editor.yank         flags: [line] #todo

    bind "ge"    fn: editor.prevWord     flags: [end]
    bind "gj"    fn: editor.lineDown     flags: [multiline]        #todo
    bind "gk"    fn: editor.lineUp       flags: [multiline]        #todo
    bind "gg"    fn: editor.goToTop

    bind "C-d"   fn: editor.halfPageDown
    bind "C-u"   fn: editor.halfPageUp
    bind "esc"   fn: editor.enterNormalMode
}

# normal mode editor commands
mode normal(Editor) {
    bind "/"     fn: editor.find                                      #todo
    bind "*"     fn: editor.findWordUnderCursor                       #todo

    bind "A"     fn: editor.insertAfterLine
    bind "C"     fn: editor.changeAfterCursor
    bind "D"     fn: editor.deleteAfterCursor
    bind "I"     fn: editor.insertBeforeLine
    bind "N"     fn: editor.moveToMatch       flags: [prev]           #todo
    bind "O"     fn: editor.insertAbove

    bind "a"     fn: editor.insertAfter
    bind "i"     fn: editor.insertBefore
    bind "n"     fn: editor.moveToMatch                               #todo
    bind "u"     fn: editor.undo
    bind "r"     fn: editor.replace                                   #todo
    bind "o"     fn: editor.insertBelow

    bind "cc"    fn: editor.changeLine
    bind "dd"    fn: editor.deleteLine
    bind "df"    fn: editor.deleteCurToChar  flags: [op, await, incl]  #todo
    bind "dw"    fn: editor.deleteWord       flags: [remaining]       #todo
    bind "daw"   fn: editor.deleteWord       flags: [outer]           #todo
    bind "diw"   fn: editor.deleteWord                                #todo

    bind "C-r"   fn: editor.redo
}

# insert mode editor commands
mode insert(Editor) {
    bind "esc"         fn: editor.enterNormalMode
    bind "enter"       fn: editor.newLine
    bind "backspace"   fn: editor.deleteCharBefore
    bind "delete"      fn: editor.deleteCharAfter
    bind "tab"         fn: editor.insertTabChar
}

mode visual(Editor) {
    bind "y"     fn: editor.yank
    bind "iw"    fn: editor.select       flags: [word]
    bind "aw"    fn: editor.select       flags: [word,outer]
}

mode visual(Editor), visual_line(Editor), visual_block(Editor) {
    bind "y"     fn: editor.yank
}



